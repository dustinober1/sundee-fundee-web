# Stripe
# Get this from https://dashboard.stripe.com/apikeys (use test key for dev, live key for production)
STRIPE_SECRET_KEY=sk_test_...

# Optional: override the site URL used for Stripe redirect URLs.
# The checkout route will otherwise use the current request origin automatically.
# SITE_URL=http://localhost:3000

# Optional Supabase cloud sync. Leave blank to support local-only PWA mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Stripe webhook verification for donation events.
STRIPE_WEBHOOK_SECRET=

# Optional Google Search Console HTML tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Cloudflare Web Analytics beacon token (from the Cloudflare dashboard,
# Web Analytics -> your site -> JS snippet). Leave blank to disable analytics.
# Must be set at build time — NEXT_PUBLIC_* values inline into the bundle.
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
